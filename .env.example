MESH_API_KEY=rsk_replace_me
MESH_BASE_URL=https://api.meshapi.ai/v1
MESH_CHAT_MODEL=openai/gpt-4o-mini
MESH_EMBEDDING_MODEL=openai/text-embedding-3-small
DATABASE_URL=sqlite:///./smartreco.db
SECRET_KEY=replace-with-a-long-random-value
ADMIN_EMAIL=admin@smartreco.local
ADMIN_PASSWORD=ChangeMe123!
CHROMA_PATH=./chroma_data
RECO_MIN_SCORE=8
RECO_COOLDOWN_MINUTES=20
ENABLE_SCHEDULER=true
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=
SMTP_FROM=SmartReco <you@example.com>
SMTP_USE_TLS=true
# SendGrid: username must be literally "apikey"; password is your SendGrid API key.
# Verify the From address (or domain) in SendGrid before sending.
# Optional LangSmith observability (bonus)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=smartreco
